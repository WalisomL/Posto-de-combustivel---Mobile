<?xml version="1.0" encoding="utf-8"?>
<LinearLayout android:background="#0B1120" android:gravity="center" android:layout_height="match_parent" android:layout_width="match_parent" android:orientation="vertical" android:padding="24dp" xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto">

    <TextView android:layout_height="wrap_content" android:layout_marginBottom="48dp" android:layout_width="wrap_content" android:letterSpacing="0.1" android:text="FUEL TRACKER" android:textColor="#10B981" android:textSize="32sp" android:textStyle="bold"/>

    <androidx.cardview.widget.CardView
        android:id="@+id/cardAbastecimento"
        android:layout_width="match_parent"
        android:layout_height="120dp"
        android:layout_marginBottom="24dp"
        app:cardBackgroundColor="#1E293B"
        app:cardCornerRadius="16dp"
        app:cardElevation="8dp">

        <LinearLayout android:gravity="center" android:layout_height="match_parent" android:layout_width="match_parent" android:orientation="vertical">

            <TextView android:layout_height="wrap_content" android:layout_width="wrap_content" android:text="Registrar Abastecimento" android:textColor="#F8FAFC" android:textSize="20sp" android:textStyle="bold"/>
            <TextView android:layout_height="wrap_content" android:layout_marginTop="4dp" android:layout_width="wrap_content" android:text="Estatísticas e Consumo" android:textColor="#94A3B8" android:textSize="14sp"/>
        </LinearLayout>
    </androidx.cardview.widget.CardView>

    <androidx.cardview.widget.CardView
        android:id="@+id/cardCalculadora"
        android:layout_width="match_parent"
        android:layout_height="120dp"
        app:cardBackgroundColor="#1E293B"
        app:cardCornerRadius="16dp"
        app:cardElevation="8dp">

        <LinearLayout android:gravity="center" android:layout_height="match_parent" android:layout_width="match_parent" android:orientation="vertical">

            <TextView android:layout_height="wrap_content" android:layout_width="wrap_content" android:text="Etanol x Gasolina" android:textColor="#F8FAFC" android:textSize="20sp" android:textStyle="bold"/>
            <TextView android:layout_height="wrap_content" android:layout_marginTop="4dp" android:layout_width="wrap_content" android:text="Descubra a opção mais vantajosa" android:textColor="#94A3B8" android:textSize="14sp"/>
        </LinearLayout>
    </androidx.cardview.widget.CardView>
</LinearLayout>